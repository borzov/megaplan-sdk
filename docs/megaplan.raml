                required: false
                name: onlyRequestedFields
                type: boolean
        responses:
            200:
                body: { type: 'CallInfo[]' }
    post:
        description: 'Создание сущности звонка, при этом у пользователя активируется виджет телефонии с соответсвующим режимом.. Входящий или исходящий определяется по типу в передаваемой CallInfo.. Текущий статус звонка (звонок, разговор и т.д.) определяется по state в CallInfo.'
        body:
            description: 'структура данных по звонку'
            required: true
            type: CallInfo
        responses:
            200:
                body: { type: CallInfo }
