#%RAML 1.0
version: r2510.27309.181
title: 'Megaplan API v3'
protocols:
    - HTTPS
mediaType: application/json
types:
    AccessSettingsItem:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            element:
                description: 'Элемент на который изначально выданы права'
                type: Element
                required: false
            member:
                description: 'Пользователь или группа'
                type: ContractorCompany|ContractorHuman|Employee|Group
                required: false
            accessLevel:
                description: 'Уровень доступа'
                type: string
                required: false
                enum: [read, edit, share]
            canEdit:
                description: 'Возможность редактирования'
                type: boolean
                required: false
            contentType:
                description: 'Object type'
                type: string
    Account:
        type: BaseEntity
        description: 'Состояние аккаунта'
        properties:
            currentTariff:
                description: 'Текущий тариф'
                type: AccountTariff
                required: false
            promoUrl:
                description: 'Ссылка на ЛК'
                type: string
                required: false
            licenseCount:
                description: 'Текущее число лицензий'
                type: integer
                required: false
            monthCount:
                description: 'Количество месяцев при последнем продлении'
                type: integer
                required: false
            tariffs:
                description: 'Доступные для аккаунта тарифы'
                type: 'AccountTariff[]'
                required: false
            tariffsCount:
                description: NO_DESCRIPTION
                type: integer
                required: false
            smsCount:
                description: Смс-баланс
                type: integer
                required: false
            expirationDate:
                description: Смс-баланс
                type: DateOnly
                required: false
            registrationSource:
                description: 'Источник регистрации'
                type: string
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AccountAutoPay:
        type: BaseEntity
        description: Автоплатеж
        properties:
            state:
                description: Статус
                type: string
                required: false
            sum:
                description: Сумма
                type: Money
                required: false
            nextPayTime:
                description: 'Дата следующей оплаты'
                type: DateTime
                required: false
            description:
                description: Описание
                type: string
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AccountDoc:
        type: BaseEntity
        description: 'Документ клиента'
        properties:
            name:
                description: 'Название файла вместе с расширением'
                type: string
                required: true
            url:
                description: 'Путь к файлу для скачивания'
                type: string
                required: true
            timeCreated:
                description: NO_DESCRIPTION
                type: DateTime
                required: false
            size:
                description: NO_DESCRIPTION
                type: string
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AccountInfo:
        type: BaseEntity
        description: 'Сущность без маппера и персистера.. Собирается налету в своем контроллере.. Инкапсулирует некоторую информацию об аккаунте.'
        properties:
            permanentHost:
                description: 'Статичный хост присваивающийся аккаунту при создании.'
                type: string
                required: false
            accountName:
                description: 'Название аккаунта'
                type: string
                required: false
            buildVersion:
                description: 'Версия билда'
                type: string
                required: false
            productName:
                description: 'Название тарифа'
                type: string
                required: false
            systemProductName:
                description: 'Системное название тарифа (класс тарифа)'
                type: string
                required: false
            tarifId:
                description: 'Ид тарифа (короткое представление, используемое в AccountTarif)'
                type: string
                required: false
            ecometHost:
                description: 'Сервер вебсокета'
                type: string
                required: false
            ecometPort:
                description: 'Порт сервера вебсокета'
                type: integer
                required: false
            ecometToken:
                description: 'Токен текущего пользователя для подключения к вебсокету'
                type: string
                required: false
            licenceEndDate:
                description: 'Срок действия лицензии'
                type: DateOnly
                required: false
            mobileEndDate:
                description: 'Срок действия мобильного приложения'
                type: DateOnly
                required: false
            paidToDate:
                description: 'Оплачен до'
                type: DateOnly
                required: false
            licenceQuantity:
                description: 'Число лицензий'
                type: integer
                required: false
            paidLicenceQuantity:
                description: 'Число оплаченных лицензий'
                type: integer
                required: false
            partnerId:
                description: 'Id партнера'
                type: integer
                required: false
            licenseExpired:
                description: 'Лицензия истекла'
                type: boolean
                required: false
            enabledModules:
                description: 'Модули мегаплана'
                type: 'Module[]'
                required: false
            enabledModulesCount:
                description: NO_DESCRIPTION
                type: integer
                required: false
            isTest:
                description: 'Является ли данная версия приложения тестовой'
                type: boolean
                required: false
            megamailDomain:
                description: 'Домен аккаунта'
                type: string
                required: false
            caldavSyncs:
                description: 'Внешние календари'
                type: 'IntegrationInfo[]'
                required: false
            caldavSyncsCount:
                description: 'Количество внешних календарей'
                type: integer
                required: false
            isSaas:
                description: 'Облачная версия'
                type: boolean
                required: false
            isFree:
                description: 'Бесплатная версия'
                type: boolean
                required: false
            isDemo:
                description: 'Является ли данная версия демо версией'
                type: boolean
                required: false
            defaultCountryCode:
                description: 'Дефолтное значение телефонного кода страны'
                type: integer
                required: false
            daysRemaining:
                description: 'Дней до окончания лицензии'
                type: integer
                required: false
            maxDiskSpace:
                description: 'Максимальное дисковое пространство'
                type: integer
                required: false
            usedMemory:
                description: 'Занятое дисковое пространство'
                type: integer
                required: false
            timeCreated:
                description: NO_DESCRIPTION
                type: DateTime
                required: false
            jivoId:
                description: 'id аккаунта в JivoSite'
                type: string
                required: false
            cqHash:
                description: 'hash для CarrotQuest'
                type: string
                required: false
            cqUserId:
                description: 'UserId в CarrotQuest'
                type: string
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AccountOrder:
        type: BaseEntity
        description: 'Заказ клиента (сделка в megaplan.megaplan.ru)'
        properties:
            id:
                description: 'Соответствует id сделки в mm.ru'
                type: string
            productType:
                description: 'Тип продукта'
                type: string
                required: false
            tariff:
                description: Тариф
                type: AccountTariff
                required: false
            licenseCount:
                description: 'Число лицензий'
                type: integer
                required: false
            monthCount:
                description: 'Количество месяцев'
                type: integer
                required: false
            price:
                description: 'Цена заказа'
                type: number
                required: false
            currency:
                description: Валюта
                type: Currency
                required: false
            isUnpaid:
                description: Оплаченность
                type: boolean
                required: false
            isTelephony:
                description: 'Является ли заказ услугой телефонии'
                type: boolean
                required: false
            isLastUnpaid:
                description: 'Последняя неоплаченная сделка?'
                type: boolean
                required: false
            description:
                description: Описание
                type: string
                required: false
            status:
                description: Статус
                type: string
                required: false
            inProcess:
                description: 'В обработке'
                type: boolean
                required: false
            date:
                description: Дата
                type: DateOnly
                required: false
            shortDescription:
                description: 'Краткое описание'
                type: string
                required: false
            oldLicenseCount:
                description: 'Число лицензий на момент создания заказа'
                type: integer
                required: false
            packetObject:
                description: 'Тип объекта, пакет которых покупается'
                type: string
                required: false
            packetObjectCount:
                description: 'Количество объектов в пакете'
                type: integer
                required: false
            contentType:
                description: 'Object type'
                type: string
    AccountOrderPrice:
        type: BaseValue
        description: 'Итоговая цена заказа'
        properties:
            description:
                description: NO_DESCRIPTION
                type: string
                required: false
            price:
                description: NO_DESCRIPTION
                type: number
                required: false
            currency:
                description: NO_DESCRIPTION
                type: Currency
                required: false
            contentType:
                description: 'Object type'
                type: string
    AccountTariff:
        type: BaseEntity
        description: 'Тариф мегаплана'
        properties:
            id:
                description: Идентификатор
                type: string
                enum: [collaboration2012, collaborationplus, crmlite, crm2012, crmplus, crm2020, crmbusiness]
            name:
                description: NO_DESCRIPTION
                type: string
                required: false
            price:
                description: NO_DESCRIPTION
                type: number
                required: false
            currency:
                description: NO_DESCRIPTION
                type: Currency
                required: false
            contentType:
                description: 'Object type'
                type: string
    Action:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            title:
                description: NO_DESCRIPTION
                type: string
                required: false
            icon:
                description: NO_DESCRIPTION
                type: string
                required: false
            contentType:
                description: 'Object type'
                type: string
    ActionHistory:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            text:
                description: NO_DESCRIPTION
                type: string
                required: false
            status:
                description: NO_DESCRIPTION
                type: string
                required: false
            message:
                description: NO_DESCRIPTION
                type: string
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    ActivityDesktopWidget:
        type: BaseEntity
        description: 'Виджет ленты активности'
        properties:
            title:
                description: 'Заголовок/название виджета'
                type: string
                required: false
            posX:
                description: NO_DESCRIPTION
                type: integer
                required: true
            posY:
                description: NO_DESCRIPTION
                type: integer
                required: true
            scale:
                description: 'Масштаб: компактный, портретный, просторный, свободный'
                type: string
                required: false
                enum: [compact, iconic, spacious, free]
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AddComment:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            comment:
                description: NO_DESCRIPTION
                type: Comment
                required: false
            askTitle:
                description: NO_DESCRIPTION
                type: string
                required: false
            required:
                description: NO_DESCRIPTION
                type: boolean
                required: false
            needRuntimeParams:
                description: 'Флаг того, что операции нужны данные от пользователя.. Сама проверка проходит отдельно, при формировании списка операций, и если операция попала в список клиенту,. то значение точно true, поэтому оно здесь и захардкожено.. Кроме этого параметр выполняет важную роль - не дать операции стать "пустой сущностью", если нет никаких заданных параметров.. Тогда маппер не вернет её из апи, а она нам нужна самим фактом своего наличия.'
                type: boolean
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AdditionalContactData:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            name:
                description: 'Имя разработчика'
                type: string
                required: false
            phone:
                description: Телефон
                type: string
                required: false
            telegram:
                description: Телеграм
                type: string
                required: false
            maxMessenger:
                description: MAX
                type: string
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    Address:
        type: BaseValue
        description: Адрес
        properties:
            type:
                description: Тип
                type: AddressType
                required: false
            value:
                description: Значение
                type: string
                required: false
            isMain:
                description: Основной
                type: boolean
                required: false
            city:
                description: Город
                type: City
                required: false
            street:
                description: Улица
                type: string
                required: false
            house:
                description: Дом
                type: string
                required: false
            metro:
                description: Метро
                type: Metro
                required: false
            contentType:
                description: 'Object type'
                type: string
    AddressType:
        type: BaseEntity
        description: 'Тип адреса'
        properties:
            name:
                description: Название
                type: string
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AggregationOperation:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            alias:
                description: NO_DESCRIPTION
                type: string
                required: false
            name:
                description: NO_DESCRIPTION
                type: string
                required: true
                enum: [sum, count, max, min, avg, filled, empty]
            possibleFieldTypes:
                description: NO_DESCRIPTION
                type: 'string[]'
                required: false
            contentType:
                description: 'Object type'
                type: string
    AggregationResult:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            value:
                description: NO_DESCRIPTION
                type: DateOnly|DateTime|Number|SpaceMoney
                required: false
            aggregation:
                description: NO_DESCRIPTION
                type: WidgetAggregation
                required: false
            contentType:
                description: 'Object type'
                type: string
    AndRule:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            children:
                description: NO_DESCRIPTION
                type: '(AndRule|BoolFieldRule|CurrentTimeRule|CurrentUserRule|DateFieldRule|EnumFieldRule|FieldValueChangedRule|FormulaRule|InstanceCreatedRule|MailWasReadRule|MoneyFieldRule|NewCommentRule|NotRule|NumberFieldRule|OrRule|PaidRule|ProgramStateChangedRule|ProgramStateRule|RefFieldRule|StringFieldRule|UnsupportedFieldRule)[]'
                required: false
            contentType:
                description: 'Object type'
                type: string
    Anonymous:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            userId:
                description: Значение
                type: string
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AnotherExampleEntity:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            description:
                description: NO_DESCRIPTION
                type: string
                required: false
            createdAt:
                description: NO_DESCRIPTION
                type: DateTime
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    ApiCall:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            method:
                description: HTTP-method
                type: string
                required: true
                enum: [GET, POST, PUT, PATCH, DELETE]
            url:
                description: 'URL part after domain'
                type: string
                required: true
            body:
                description: 'Request body content'
                type: string
                required: false
            contentType:
                description: 'Object type'
                type: string
    AppCategory:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            id:
                description: NO_DESCRIPTION
                type: string
            title:
                description: Название
                type: string
                required: false
            contentType:
                description: 'Object type'
                type: string
    Application:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            id:
                description: NO_DESCRIPTION
                type: string
            title:
                description: Название
                type: string
                required: false
            categories:
                description: Категории
                type: 'AppCategory[]'
                required: false
            categoriesCount:
                description: NO_DESCRIPTION
                type: integer
                required: false
            installed:
                description: Установлено
                type: boolean
                required: false
            type:
                description: 'Тип приложения'
                type: string
                required: false
            description:
                description: Описание
                type: string
                required: false
            shortDescription:
                description: 'Краткое описание'
                type: string
                required: false
            image:
                description: 'Иконка приложения'
                type: string
                required: false
            dateCreated:
                description: 'Дата создания'
                type: string
                required: false
            free:
                description: Бесплатно
                type: boolean
                required: false
            popularForYear:
                description: 'Количество установок за год'
                type: integer
                required: false
            popularSixMonths:
                description: 'Количество установк за пол года'
                type: integer
                required: false
            enabled:
                description: 'Состояние приложения'
                type: boolean
                required: false
            linkHref:
                description: 'Ссылка на сайт'
                type: string
                required: false
            installHref:
                description: 'Ссылка на установку'
                type: string
                required: false
            installBtn:
                description: 'Кнопка установки'
                type: boolean
                required: false
            developerName:
                description: 'Название разработчика'
                type: string
                required: false
            contentType:
                description: 'Object type'
                type: string
    ApplyTemplateRequest:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            templates:
                description: NO_DESCRIPTION
                type: 'Template[]'
                required: false
            contentType:
                description: 'Object type'
                type: string
    Approval:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            type:
                description: NO_DESCRIPTION
                type: string
                required: false
            time:
                description: NO_DESCRIPTION
                type: DateTime
                required: false
            deadline:
                description: NO_DESCRIPTION
                type: DateTime
                required: false
            entity:
                description: NO_DESCRIPTION
                type: BaseEntity
                required: false
            status:
                description: NO_DESCRIPTION
                type: string
                required: false
            owner:
                description: NO_DESCRIPTION
                type: BaseEntity
                required: false
            accept:
                description: NO_DESCRIPTION
                type: string
                required: false
            acceptAction:
                description: NO_DESCRIPTION
                type: string
                required: false
            reject:
                description: NO_DESCRIPTION
                type: string
                required: false
            rejectAction:
                description: NO_DESCRIPTION
                type: string
                required: false
            sort:
                description: NO_DESCRIPTION
                type: integer
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AskPayer:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            payer:
                description: NO_DESCRIPTION
                type: Payer
                required: false
            needRuntimeParams:
                description: 'Флаг того, что операции нужны данные от пользователя.. Сама проверка проходит отдельно, при формировании списка операций, и если операция попала в список клиенту,. то значение точно true, поэтому оно здесь и захардкожено.. Кроме этого параметр выполняет важную роль - не дать операции стать "пустой сущностью", если нет никаких заданных параметров.. Тогда маппер не вернет её из апи, а она нам нужна самим фактом своего наличия.'
                type: boolean
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AttachesInfo:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            imageFiles:
                description: 'Файлы изображений'
                type: 'File[]'
                required: false
            imageFilesCount:
                description: 'Количество файлов изображений'
                type: integer
                required: false
            audioFiles:
                description: 'Звуковые файлы'
                type: 'File[]'
                required: false
            audioFilesCount:
                description: 'Количество звуковых файлов'
                type: integer
                required: false
            otherFiles:
                description: 'Другие файлы'
                type: 'File[]'
                required: false
            otherFilesCount:
                description: 'Количество файлов другого типа'
                type: integer
                required: false
            contentType:
                description: 'Object type'
                type: string
    AudioFileMetadata:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            duration:
                description: NO_DESCRIPTION
                type: integer
                required: false
            contentType:
                description: 'Object type'
                type: string
    AuthenticatedRequest:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            secret:
                description: NO_DESCRIPTION
                type: string
                required: true
            type:
                description: NO_DESCRIPTION
                type: string
                required: true
                enum: [password, google]
            prevAuthenticateRequest:
                description: NO_DESCRIPTION
                type: AuthenticatedRequest
                required: false
            contentType:
                description: 'Object type'
                type: string
    AuthorizationRequest:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            hash:
                description: NO_DESCRIPTION
                type: string
                required: true
            key:
                description: NO_DESCRIPTION
                type: string
                required: true
            contentType:
                description: 'Object type'
                type: string
    AutocompleteFilter:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            contentTypes:
                description: NO_DESCRIPTION
                type: 'string[]'
                required: false
            q:
                description: NO_DESCRIPTION
                type: string
                required: false
            contentType:
                description: 'Object type'
                type: string
    Automation:
        type: BaseEntity
        description: NO_DESCRIPTION
        properties:
            name:
                description: NO_DESCRIPTION
                type: string
                required: false
            description:
                description: NO_DESCRIPTION
                type: string
                required: false
            config:
                description: NO_DESCRIPTION
                type: AutomationConfig
                required: false
            group:
                description: NO_DESCRIPTION
                type: AutomationGroup
                required: false
            enabled:
                description: NO_DESCRIPTION
                type: boolean
                required: false
            id:
                description: Идентификатор
                type: string
            contentType:
                description: 'Object type'
                type: string
    AutomationConfig:
        type: BaseValue
        description: NO_DESCRIPTION
        properties:
            trigger:
