'/contractorHuman/{entityId}/todos':
    post:
        description: 'Создание события'
        queryParameters:
            entityId:
                description: 'Идентификатор сущности'
                required: true
                name: entityId
                type: integer
        body:
            description: NO_DESCRIPTION
            required: true
            type: Todo
        responses:
            200:
                body: { type: Todo }
    get:
        description: 'Получение событий для таска'
        queryParameters:
            finished:
                description: 'Показывать только завершенные'
                required: false
                name: finished
                type: boolean
