'/systemSetting/{id}':
    get:
        description: 'id представляет собой строку: {scope}/{id}. Для получения всех настроек по scope передается id в виде {scope}. Для получения конкретной настройки необходимо передать параметр {scope}/{id}. На данный момент доступен только один scope = callServerConfig - серверные настройки для телефонии'
        queryParameters:
            id:
                description: 'Идентификатор настройки в скоупе'
                required: true
                name: id
                type: string
            pageAfter:
                description: 'Загрузить страницу, начиная с переданной сущности.'
                required: false
                name: pageAfter
                type: BaseEntity
            pageBefore:
                description: 'Загрузить страницу строго до переданной сущности.'
                required: false
                name: pageBefore
                type: BaseEntity
            pageWith:
                description: 'Загрузить страницу c наличием переданной сущности.'
                required: false
                name: pageWith
                type: BaseEntity
            limit:
                description: 'Сколько элементов включать в страницу.'
                required: false
                name: limit
                type: integer
            fields:
                description: 'Набор дополнительных полей, включённых в список'
                required: false
                name: fields
                type: any
            sortBy:
                description: 'массив полей сортировки'
                required: false
                name: sortBy
                type: 'SortField[]'
            onlyRequestedFields:
                description: 'отдавать только перечисленные поля'
                required: false
                name: onlyRequestedFields
                type: boolean
        responses:
            200:
                body: { type: 'SystemSetting[]' }
    post:
        description: 'Редактирование системной настройки по скоупу и идентификатору.'
        body:
            description: NO_DESCRIPTION
            required: true
            type: SystemSetting
        queryParameters:
            id:
                description: 'Идентификатор настройки в скоупе'
                required: true
                name: id
                type: string
        responses:
            200:
                body: { type: Response|SystemSetting }
    delete:
