                description: 'Показывать все дела'
                required: false
                name: all
                type: boolean
            period:
                description: 'За какой период возвращать дела'
                required: false
                name: period
                type: string
            sortable:
                description: 'Использовать ли сохраненную сортировку?'
                required: false
                name: sortable
                type: boolean
            filters:
                description: NO_DESCRIPTION
                required: false
                name: filters
                type: 'TodoDateTimeFilter[]'
            q:
                description: 'Строка поиска'
                required: false
                name: q
                type: string
            pageAfter:
                description: 'Загрузить страницу, начиная с переданной сущности.'
                required: false
                name: pageAfter
                type: BaseEntity
            pageBefore:
                description: 'Загрузить страницу строго до переданной сущности.'
                required: false
                name: pageBefore
                type: BaseEntity
            pageWith:
                description: 'Загрузить страницу c наличием переданной сущности.'
                required: false
                name: pageWith
                type: BaseEntity
            limit:
                description: 'Сколько элементов включать в страницу.'
                required: false
                name: limit
                type: integer
            fields:
                description: 'Набор дополнительных полей, включённых в список'
                required: false
                name: fields
                type: any
            sortBy:
                description: 'массив полей сортировки'
                required: false
                name: sortBy
                type: 'SortField[]'
            onlyRequestedFields:
                description: 'отдавать только перечисленные поля'
                required: false
                name: onlyRequestedFields
                type: boolean
            entityId:
                description: 'Идентификатор сущности'
                required: true
                name: entityId
                type: integer
        responses:
            200:
                body: { type: 'Todo[]' }
